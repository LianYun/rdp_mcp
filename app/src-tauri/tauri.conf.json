{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rdp_mcp",
  "version": "0.1.0",
  "identifier": "com.lianyun.rdp-mcp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "rdp_mcp",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "visible": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "rdp_mcp Desktop",
    "longDescription": "Manage the rdp-mcp service: Windows machines over RDP for MCP clients.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/rdp-mcp", "binaries/rdp-worker"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libfreerdp3-3", "libfreerdp-client3-3", "libwinpr3-3"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
